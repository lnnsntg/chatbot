# Backend environment variables

# Cloud LLM (OpenCode Zen Go, OpenAI-compatible)
# API key: OpenCode Console (https://opencode.ai/console)
CLOUD_API_KEY=
CLOUD_MODEL=deepseek-v4.1-flash
CLOUD_API_URL=https://opencode.ai/zen/go/v1/chat/completions
# Cabecera obligatoria de OpenCode Zen Go (sin ella: 400 MissingSessionID)
CLOUD_SESSION=chatbot
