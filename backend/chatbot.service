[Unit]
Description=Chatbot Backend API
After=network.target chatbot.socket
Requires=chatbot.socket

[Service]
Type=notify
User=root
Group=www-data
WorkingDirectory=/var/www/chatbot/backend
ExecStart=/var/www/chatbot/backend/.venv/bin/gunicorn main:app --workers 2 --worker-class uvicorn.workers.UvicornWorker --bind fd://3
Restart=always
RestartSec=10
Environment=PYTHONPATH=/var/www/chatbot/backend

[Install]
WantedBy=multi-user.target
