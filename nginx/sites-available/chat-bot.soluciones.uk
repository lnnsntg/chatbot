server {
    if ($host = chat-bot.soluciones.uk) {
        return 301 https://$host$request_uri;
    } # managed by Certbot


    listen 80;
    server_name chat-bot.soluciones.uk;

    location /.well-known/acme-challenge/ {
        root /var/www/html;
    }

    location / {
        return 301 https://$host$request_uri;
    }


}

server {
    listen 443 ssl http2;
    server_name chat-bot.soluciones.uk;
    ssl_certificate /etc/letsencrypt/live/chat-bot.soluciones.uk/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/chat-bot.soluciones.uk/privkey.pem; # managed by Certbot

    root /var/www/chatbot/frontend/dist;
    index index.html;

    location / {
        try_files $uri $uri/ /index.html;
    }

    location /api/ {
        proxy_pass http://unix:/run/chatbot/chatbot.sock;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /chat {
        proxy_pass http://unix:/run/chatbot/chatbot.sock;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # el LLM puede tardar: el timeout por defecto (60s) corta la respuesta
        proxy_read_timeout 120s;
    }

    location /health {
        proxy_pass http://unix:/run/chatbot/chatbot.sock;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

}
